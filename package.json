{
  "name": "adversarial-api-security-fuzzer",
  "version": "0.1.0",
  "description": "An AI-powered adversarial fuzzer that uses Red Team and Blue Team subagents to discover and patch API vulnerabilities.",
  "private": true,
  "type": "module",
  "scripts": {
    "target": "tsx --tsconfig tsconfig.json target-api/src/server.ts",
    "fuzzer": "tsx --tsconfig tsconfig.json fuzzer/src/orchestrator/index.ts",
    "verify": "tsx --tsconfig tsconfig.json fuzzer/src/orchestrator/verify.ts",
    "dev": "concurrently \"npm run target\" \"npm run fuzzer\"",
    "build": "tsc --project tsconfig.json",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/jwt": "^9.0.0",
    "@fastify/sensible": "^6.0.0",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.30.10",
    "fastify": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.21.4",
    "eslint": "^8.57.0",
    "tsx": "^4.15.6",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
