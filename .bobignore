# Bob-specific ignores — prevents secrets and volatile artefacts from being
# picked up as workspace context or committed via Bob actions.

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Database files (contain seeded user data / tokens)
*.sqlite
*.sqlite3
*.db

# Build output
dist/
*.js.map

# Logs (generated by fuzzer runs — can be large)
logs/*.json
logs/*.diff

# Node
node_modules/

# OS
.DS_Store
Thumbs.db
